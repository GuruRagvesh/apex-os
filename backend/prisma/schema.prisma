/// Lifecycle of a daily attendance RESULT, distinct from its classification.
///
/// status answers "what happened that day"; this answers "can we trust it yet".
/// A PRESENT day with a geofence exception is still PRESENT -- it is the state
/// that says a human must look, not the status.
enum DailyAttendanceEvaluationState {
  CALCULATED
  NEEDS_REVIEW
  FINALIZED
}

