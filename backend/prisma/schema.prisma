  PUNCH_OUT
}

// Set by the server. PE-1 always records PENDING; PE-2 adds the geofence
// calculation that resolves it.
enum PunchLocationVerification {
  PENDING
  VERIFIED
  /// Geofencing is switched off by the governing AttendancePolicy. GPS was
  /// still captured and stored; it simply was not enforced against a location.
  /// Deliberately NOT reported as VERIFIED, which would falsely imply the
  /// employee was inside an approved location.
  NOT_ENFORCED
  OUTSIDE_GEOFENCE
  LOW_ACCURACY
  UNAVAILABLE
  NEEDS_REVIEW
}

// Set by the server. PE-1 always records PENDING; PE-3 adds live capture and
// storage that resolves it.
enum PunchPhotoVerification {
  PENDING
  CAPTURED
  MISSING
  REJECTED
  NEEDS_REVIEW
}

enum PunchSource {
  WEB
  PWA
  MOBILE
  MANUAL_APPROVED
}

// Lifecycle shared by every versioned attendance policy record.
// A record that has ever been ACTIVE is never edited in place; it is
// SUPERSEDED by a new version, so historical meaning is preserved.
enum PolicyStatus {
  DRAFT
  APPROVED
  ACTIVE
  SUPERSEDED
}

// What a policy version says to do about a situation whose business rule
// management has not yet settled. REQUIRE_REVIEW is the safe default: produce
// no automatic payroll-affecting outcome and escalate to HR instead.
enum PolicyDecisionAction {
  REQUIRE_REVIEW
  NO_ACTION
  MARK_HALF_DAY
  MARK_ABSENT
  DEDUCT_HALF_PAID_LEAVE
  DEDUCT_FULL_PAID_LEAVE
  MARK_LWP
}
