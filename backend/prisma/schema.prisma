generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                         @id @default(cuid())
  email                     String                         @unique
  name                      String
  password                  String
  avatar                    String?
  isActive                  Boolean                        @default(true)
  roleId                    String
  departmentId              String?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  mustChangePassword        Boolean                        @default(true)
  photoUrl                  String?
  isHR                      Boolean                        @default(false)
  currentStatus             String                         @default("OFFLINE")
  lastActiveAt              DateTime?
  phone                     String?
  dateOfBirth               DateTime?
  gender                    String?
  bloodGroup                String?
  currentAddress            String?
  permanentAddress          String?
  emergencyName             String?
  emergencyPhone            String?
  emergencyRelation         String?
  userLocation              String?                        @default("Pune HQ")
  employeeId                String?                        @unique
  designation               String?
  employmentType            String?                        @default("Full-time")
  workMode                  String?                        @default("Office")
  joiningDate               DateTime?
  probationPeriod           String?
  reportingManager          String?
  teamLeadName              String?
  workLocation              String?                        @default("Pune HQ")
  shiftTiming               String?                        @default("9:30 AM - 6:30 PM")
  ctcAnnual                 String?
  basicSalary               String?
  salaryStructure           String?
  bankName                  String?
  accountNumber             String?
  ifscCode                  String?
  accountHolderName         String?
  paymentMode               String?
  panNumber                 String?
  aadhaarNumber             String?
  uanNumber                 String?
  pfApplicable              Boolean?                       @default(true)
  esicApplicable            Boolean?                       @default(false)
  professionalTax           Boolean?                       @default(true)
  taxRegime                 String?
  verificationStatus        String?                        @default("Pending")
  verifiedBy                String?
  verificationDate          DateTime?
  hrNotes                   String?
  bio                       String?
  activityLogs              ActivityLog[]
  attendanceEvents          AttendanceEvent[]
  attendanceProfile         EmployeeAttendanceProfile?
  attendanceRegularizations AttendanceRegularization[]
  breakLogs                 BreakLog[]
  comments                  Comment[]
  dailyAttendanceRecords    DailyAttendance[]
  employeeDocuments         EmployeeDocument[]
  changeRequestsApproving   EmployeeProfileChangeRequest[] @relation("ChangeRequestCurrentApprover")
  changeRequestsCreated     EmployeeProfileChangeRequest[] @relation("ChangeRequestRequester")
  changeRequestsTarget      EmployeeProfileChangeRequest[] @relation("ChangeRequestTarget")
  leaveRequests             LeaveRequest[]
  managedDepts              ManagerDeptAccess[]            @relation("ManagerAccess")
  notifications             Notification[]
  operationalEvents         OperationalEvent[]             @relation("EventActor")
  projectMembers            ProjectMember[]
  assigneeCycles            ReviewCycleLog[]               @relation("CycleAssignee")
  reviewerCycles            ReviewCycleLog[]               @relation("CycleReviewer")
  ticketAssignments         TicketAssignee[]
  ticketHistory             TicketHistory[]
  ticketTimeLogs            TicketTimeLog[]
  departmentMemberships     UserDepartmentMembership[]
  roleAssignments           UserRoleAssignment[]
  teamMemberships           TeamMember[]
  teamsLed                  Team[]                         @relation("TeamLeadOf")
  ticketWatching            TicketWatcher[]
  assignedTickets           Ticket[]                       @relation("TicketAssignee")
  createdTickets            Ticket[]                       @relation("TicketCreator")
  ticketsToApprove          Ticket[]                       @relation("TicketApprover")
  workdayPolicyOverride     UserWorkdayPolicyOverride?
  department                Department?                    @relation(fields: [departmentId], references: [id])
  role                      Role                           @relation(fields: [roleId], references: [id])
  workSessions              WorkSession[]

  @@index([departmentId])
  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model EmployeeDocument {
  id                 String    @id @default(cuid())
  userId             String
  documentType       String
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  verificationStatus String    @default("Pending")
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  uploadedAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
  @@map("employee_documents")
}

model Role {
  id              String               @id @default(cuid())
  name            String               @unique
  level           Int
  description     String?
  createdAt       DateTime             @default(now())
  users           User[]
  roleAssignments UserRoleAssignment[]

  @@map("roles")
}

model Department {
  id               String                     @id @default(cuid())
  name             String                     @unique
  description      String?
  color            String                     @default("#6366f1")
  createdAt        DateTime                   @default(now())
  managerAccess    ManagerDeptAccess[]
  projects         Project[]
  taskTypes        TaskType[]
  tickets          Ticket[]
  users            User[]
  userMemberships  UserDepartmentMembership[]
  roleAssignments  UserRoleAssignment[]
  teams            Team[]
  requestedTickets Ticket[]                   @relation("TicketRequestingDepartment")
  targetedTickets  Ticket[]                   @relation("TicketTargetDepartment")

  @@map("departments")
}

model Project {
  id           String          @id @default(cuid())
  projectId    String          @unique
  name         String
  description  String?
  status       ProjectStatus   @default(ACTIVE)
  priority     Priority        @default(MEDIUM)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      ProjectMember[]
  stages       ProjectStage[]
  department   Department?     @relation(fields: [departmentId], references: [id])
  tickets      Ticket[]

  @@index([departmentId])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model ProjectStage {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  order       Int       @default(0)
  /// PLANNED | ACTIVE | COMPLETED | SKIPPED  (validated at service layer)
  status      String    @default("PLANNED")
  color       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets     Ticket[]  @relation("TicketStage")

  @@index([projectId])
  @@index([projectId, order])
  @@map("project_stages")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Ticket {
  id                     String           @id @default(cuid())
  ticketId               String           @unique
  title                  String
  description            String?
  category               TicketCategory
  type                   TicketType       @default(TASK)
  status                 TicketStatus     @default(OPEN)
  priority               Priority         @default(MEDIUM)
  estimatedTime          Float?
  actualTime             Float?
  projectId              String?
  departmentId           String?
  assignedToId           String?
  createdById            String
  dueDate                DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  scheduledFor           DateTime?
  scheduledNote          String?
  scheduleRecurring      String?
  scheduleEndDate        DateTime?
  taskTypeId             String?
  taskSubtypeId          String?
  estimatedMinutes       Int?
  scheduledStartAt       DateTime?
  scheduledEndAt         DateTime?
  actualStartAt          DateTime?
  actualCompletedAt      DateTime?
  executionDueAt         DateTime?
  submittedAt            DateTime?
  reviewStartedAt        DateTime?
  reviewDueAt            DateTime?
  closedAt               DateTime?
  cancelledAt            DateTime?
  customSubtypeText      String?
  isBlocked              Boolean          @default(false)
  blockedAt              DateTime?
  blockedReason          String?
  blockedById            String?
  reworkCount            Int              @default(0)
  projectStageId         String?
  requestingDepartmentId String?
  requestingTeamId       String?
  targetDepartmentId     String?
  targetTeamId           String?
  isCrossDepartment      Boolean          @default(false)
  approvalState          ApprovalState    @default(NONE)
  approvalType           ApprovalType?
  approverId             String?
  approvalRequestedAt    DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  approvalReason         String?
  attachments            Attachment[]
  comments               Comment[]
  reviewCycles           ReviewCycleLog[]
  assignees              TicketAssignee[]
  history                TicketHistory[]
  timeLogs               TicketTimeLog[]
  watchers               TicketWatcher[]
  assignedTo             User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy              User             @relation("TicketCreator", fields: [createdById], references: [id])
  approver               User?            @relation("TicketApprover", fields: [approverId], references: [id])
  department             Department?      @relation(fields: [departmentId], references: [id])
  requestingDepartment   Department?      @relation("TicketRequestingDepartment", fields: [requestingDepartmentId], references: [id])
  targetDepartment       Department?      @relation("TicketTargetDepartment", fields: [targetDepartmentId], references: [id])
  requestingTeam         Team?            @relation("TicketRequestingTeam", fields: [requestingTeamId], references: [id])
  targetTeam             Team?            @relation("TicketTargetTeam", fields: [targetTeamId], references: [id])
  project                Project?         @relation(fields: [projectId], references: [id])
  projectStage           ProjectStage?    @relation("TicketStage", fields: [projectStageId], references: [id])
  taskSubtype            TaskSubtype?     @relation(fields: [taskSubtypeId], references: [id])
  taskType               TaskType?        @relation(fields: [taskTypeId], references: [id])

  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdById])
  @@index([projectId])
  @@index([projectStageId])
  @@index([createdAt])
  @@index([priority])
  @@index([dueDate])
  @@index([status, assignedToId])
  @@index([status, departmentId])
  @@index([isBlocked])
  @@index([status, isBlocked])
  @@index([requestingDepartmentId])
  @@index([targetDepartmentId])
  @@index([requestingTeamId])
  @@index([targetTeamId])
  @@index([isCrossDepartment])
  @@index([approvalState])
  @@index([approverId])
  @@index([status, approvalState])
  @@map("tickets")
}

model TicketAssignee {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String
  assignedAt DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_assignees")
}

model TicketWatcher {
  id       String   @id @default(cuid())
  ticketId String
  userId   String
  addedAt  DateTime @default(now())
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_watchers")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int?
  mimeType  String?
  ticketId  String
  createdAt DateTime @default(now())
  isPoc     Boolean  @default(false)
  pocFor    String?
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model LeaveRequest {
  id           String        @id @default(cuid())
  userId       String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       LeaveStatus   @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isHalfDay    Boolean       @default(false)
  halfDayType  String?
  user         User          @relation(fields: [userId], references: [id])
  workSessions WorkSession[]

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([userId, status])
  @@map("leave_requests")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType @default(INFO)
  isRead     Boolean          @default(false)
  link       String?
  createdAt  DateTime         @default(now())
  entityId   String?
  entityType String?
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model TicketHistory {
  id          String   @id @default(cuid())
  ticketId    String
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  changedAt   DateTime @default(now())
  changedBy   User     @relation(fields: [changedById], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([changedAt])
  @@map("ticket_history")
}

model TaskType {
  id           String        @id @default(cuid())
  name         String
  departmentId String?
  isGlobal     Boolean       @default(false)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  subtypes     TaskSubtype[]
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("task_types")
}

model TaskSubtype {
  id         String   @id @default(cuid())
  name       String
  taskTypeId String
  order      Int      @default(0)
  taskType   TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@unique([name, taskTypeId])
  @@index([taskTypeId])
  @@map("task_subtypes")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

model WorkSession {
  id                      String            @id @default(cuid())
  userId                  String
  date                    DateTime          @db.Date
  loginAt                 DateTime?
  startWorkAt             DateTime?
  logoutAt                DateTime?
  status                  String            @default("LOGGED_IN")
  totalLoggedMinutes      Int               @default(0)
  totalBreakMinutes       Int               @default(0)
  totalIdleMinutes        Int               @default(0)
  totalWorkMinutes        Int               @default(0)
  leaveId                 String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  autoClosed              Boolean           @default(false)
  autoClosedAt            DateTime?
  closureReason           String?
  continuationOfSessionId String?
  attendanceEvents        AttendanceEvent[]
  breakLogs               BreakLog[]
  ticketTimeLogs          TicketTimeLog[]
  leaveRequest            LeaveRequest?     @relation(fields: [leaveId], references: [id])
  user                    User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("work_sessions")
}

model BreakLog {
  id               String          @id @default(cuid())
  userId           String
  workSessionId    String
  breakType        String
  estimatedMinutes Int?
  startAt          DateTime
  endAt            DateTime?
  durationMinutes  Int?
  autoDetected     Boolean         @default(false)
  note             String?
  createdAt        DateTime        @default(now())
  reason           String?
  source           String?
  user             User            @relation(fields: [userId], references: [id])
  workSession      WorkSession     @relation(fields: [workSessionId], references: [id])
  ticketTimeLogs   TicketTimeLog[]

  @@index([userId])
  @@index([workSessionId])
  @@map("break_logs")
}

model UserWorkdayPolicyOverride {
  id                    String   @id @default(cuid())
  userId                String   @unique
  timezone              String?
  startTime             String?
  endTime               String?
  entryWindowStart      String?
  entryWindowEnd        String?
  exitWindowStart       String?
  exitWindowEnd         String?
  minimumWorkdayMinutes Int?
  flexible              Boolean  @default(false)
  reason                String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])

  @@map("user_workday_policy_overrides")
}

model AttendanceEvent {
  id                 String       @id @default(cuid())
  userId             String
  workSessionId      String?
  eventType          String
  timestamp          DateTime     @default(now())
  source             String       @default("manual")
  metadata           Json?
  // ── HRMS attendance policy foundation (Phase 1) — additive, nullable only.
  // Not yet populated or read by any service; capture UI/wiring is a later phase.
  clientTimestamp    DateTime?
  timezone           String?
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  faceImageUrl       String?
  deviceMetadata     Json?
  ipAddress          String?
  verificationStatus String?
  policyVersion      String?
  user               User         @relation(fields: [userId], references: [id])
  workSession        WorkSession? @relation(fields: [workSessionId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  @@map("attendance_events")
}

model OperationalEvent {
  id           String   @id @default(cuid())
  actorId      String
  entityType   String
  entityId     String
  action       String
  fromState    String?
  toState      String?
  metadata     Json?
  ip           String?
  device       String?
  timestamp    DateTime @default(now())
  actorRoleId  String?
  actorContext String?
  beforeValue  Json?
  afterValue   Json?
  actor        User     @relation("EventActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([timestamp])
  @@index([actorRoleId])
  @@map("operational_events")
}

model ManagerDeptAccess {
  id           String     @id @default(cuid())
  managerId    String
  departmentId String
  accessLevel  String     @default("READ")
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  manager      User       @relation("ManagerAccess", fields: [managerId], references: [id])

  @@unique([managerId, departmentId])
  @@index([managerId])
  @@map("manager_dept_access")
}

model UserDepartmentMembership {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_department_memberships")
}

model UserRoleAssignment {
  id           String      @id @default(cuid())
  userId       String
  roleId       String
  departmentId String?
  teamId       String?
  isPrimary    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role        @relation(fields: [roleId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  team         Team?       @relation(fields: [teamId], references: [id])

  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([teamId])
  @@map("user_role_assignments")
}

model Team {
  id                String               @id @default(cuid())
  name              String
  departmentId      String
  teamLeadId        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  department        Department           @relation(fields: [departmentId], references: [id])
  teamLead          User?                @relation("TeamLeadOf", fields: [teamLeadId], references: [id])
  members           TeamMember[]
  roleAssignments   UserRoleAssignment[]
  requestingTickets Ticket[]             @relation("TicketRequestingTeam")
  targetTickets     Ticket[]             @relation("TicketTargetTeam")

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([teamLeadId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TicketTimeLog {
  id              String       @id @default(cuid())
  ticketId        String
  userId          String
  stage           String
  ownerType       String
  source          String
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  countsAsWork    Boolean      @default(true)
  pauseReason     String?
  workSessionId   String?
  breakLogId      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  breakLog        BreakLog?    @relation(fields: [breakLogId], references: [id])
  ticket          Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])
  workSession     WorkSession? @relation(fields: [workSessionId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([startedAt])
  @@index([workSessionId])
  @@index([ticketId, endedAt])
  @@index([userId, endedAt])
  @@map("ticket_time_logs")
}

model ReviewCycleLog {
  id                        String    @id @default(cuid())
  ticketId                  String
  cycleNo                   Int
  assigneeId                String?
  reviewerId                String?
  reviewStartedAt           DateTime?
  reviewEndedAt             DateTime?
  decision                  String?
  feedback                  String?
  assigneeWorkSeconds       Int?
  reviewerWorkSeconds       Int?
  reworkStartedAt           DateTime?
  reworkEndedAt             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  employeeAttitudeRating    Int?
  employeePerformanceRating Int?
  ratingComment             String?
  taskEfficiencyRating      Int?
  assignee                  User?     @relation("CycleAssignee", fields: [assigneeId], references: [id])
  reviewer                  User?     @relation("CycleReviewer", fields: [reviewerId], references: [id])
  ticket                    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, cycleNo])
  @@index([ticketId])
  @@index([cycleNo])
  @@map("review_cycle_logs")
}

model EmployeeProfileChangeRequest {
  id                String    @id @default(cuid())
  targetUserId      String
  requestedById     String
  requestType       String
  status            String    @default("PENDING_TL_APPROVAL")
  changes           Json
  reason            String?
  currentApproverId String?
  tlApproverId      String?
  managerApproverId String?
  adminApproverId   String?
  tlDecision        String?
  managerDecision   String?
  adminDecision     String?
  rejectionReason   String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  currentApprover   User?     @relation("ChangeRequestCurrentApprover", fields: [currentApproverId], references: [id])
  requestedBy       User      @relation("ChangeRequestRequester", fields: [requestedById], references: [id])
  targetUser        User      @relation("ChangeRequestTarget", fields: [targetUserId], references: [id])

  @@index([targetUserId])
  @@index([requestedById])
  @@index([status])
  @@index([currentApproverId])
  @@map("employee_profile_change_requests")
}

// ════════════════════════════════════════════════════════════════════════════
// HRMS Attendance & Leave Policy foundation (Phase 1 — schema only)
// Additive only. Nothing in this section is read or written by any existing
// service yet — leave/workday behavior is unchanged until a later phase wires
// these tables in. See APEX_OS Phase 0 audit + Phase 1 schema foundation.
// ════════════════════════════════════════════════════════════════════════════

model AttendancePolicy {
  id                      String        @id @default(cuid())
  financialYear           String
  name                    String
  isActive                Boolean       @default(true)
  minimumWorkingMinutes   Int           @default(540)
  lateExemptionEnabled    Boolean       @default(true)
  faceCaptureRequired     Boolean       @default(false)
  locationCaptureRequired Boolean       @default(false)
  geoFenceEnabled         Boolean       @default(false)
  regularizationEnabled   Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  updatedById             String?
  shiftPolicies           ShiftPolicy[]

  @@index([financialYear])
  @@index([isActive])
  @@map("attendance_policies")
}

model ShiftPolicy {
  id                    String                      @id @default(cuid())
  attendancePolicyId    String
  name                  String
  category              AttendanceCategory
  startTime             String
  endTime               String
  graceMinutes          Int                         @default(10)
  minimumWorkingMinutes Int                         @default(540)
  isActive              Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  attendancePolicy      AttendancePolicy            @relation(fields: [attendancePolicyId], references: [id], onDelete: Cascade)
  employeeProfiles      EmployeeAttendanceProfile[]

  @@index([attendancePolicyId])
  @@index([category])
  @@map("shift_policies")
}

// One row per user. Deliberately does NOT remove User.reportingManager /
// User.teamLeadName (free-text fields) — those stay untouched until a later
// phase confirms nothing in the frontend still depends on them.
model EmployeeAttendanceProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  category              AttendanceCategory
  attendanceRequired    Boolean            @default(true)
  assignedShiftId       String?
  assignedLeavePolicyId String?
  reportingManagerId    String?
  hrReviewerId          String?
  effectiveFrom         DateTime           @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  updatedById           String?
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedShift         ShiftPolicy?       @relation(fields: [assignedShiftId], references: [id])
  assignedLeavePolicy   LeavePolicy?       @relation(fields: [assignedLeavePolicyId], references: [id])

  @@index([category])
  @@index([assignedShiftId])
  @@index([assignedLeavePolicyId])
  @@index([reportingManagerId])
  @@map("employee_attendance_profiles")
}

model WeeklyOffPolicy {
  id             String    @id @default(cuid())
  name           String
  everySunday    Boolean   @default(true)
  secondSaturday Boolean   @default(true)
  fourthSaturday Boolean   @default(true)
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@map("weekly_off_policies")
}

model HolidayCalendar {
  id            String    @id @default(cuid())
  financialYear String
  name          String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  holidays      Holiday[]

  @@index([financialYear])
  @@map("holiday_calendars")
}

model Holiday {
  id         String          @id @default(cuid())
  calendarId String
  date       DateTime        @db.Date
  name       String
  isOptional Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([calendarId])
  @@map("holidays")
}

model LeavePolicy {
  id                              String                      @id @default(cuid())
  financialYear                   String
  name                            String
  totalPaidLeaves                 Int                         @default(14)
  combinedPoolTypes               Json                        @default("[]")
  lwpAfterBalanceExhausted        Boolean                     @default(true)
  approvedLeavePriorityOverAbsent Boolean                     @default(true)
  weeklyOffExcluded               Boolean                     @default(true)
  holidaysExcluded                Boolean                     @default(true)
  isActive                        Boolean                     @default(true)
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  employeeProfiles                EmployeeAttendanceProfile[]

  @@index([financialYear])
  @@map("leave_policies")
}

model DailyAttendance {
  id                String                @id @default(cuid())
  userId            String
  date              DateTime              @db.Date
  status            DailyAttendanceStatus
  punchInAt         DateTime?
  punchOutAt        DateTime?
  workedMinutes     Int                   @default(0)
  breakMinutes      Int                   @default(0)
  lateMinutes       Int                   @default(0)
  leaveDeducted     Float                 @default(0)
  lwpDeducted       Float                 @default(0)
  calculationReason String?
  locked            Boolean               @default(false)
  lockedAt          DateTime?
  policyVersion     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("daily_attendance")
}

model AttendanceRegularization {
  id                String                    @id @default(cuid())
  userId            String
  date              DateTime                  @db.Date
  requestType       RegularizationRequestType
  reason            String
  requestedPunchIn  DateTime?
  requestedPunchOut DateTime?
  status            RegularizationStatus      @default(PENDING)
  managerApproverId String?
  managerDecisionAt DateTime?
  hrApproverId      String?
  hrDecisionAt      DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([status])
  @@map("attendance_regularizations")
}

