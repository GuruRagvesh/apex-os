model DailyAttendance {
  id                String                @id @default(cuid())
  userId            String
  date              DateTime              @db.Date
  status            DailyAttendanceStatus
  punchInAt         DateTime?
  punchOutAt        DateTime?
  workedMinutes     Int                   @default(0)
  breakMinutes      Int                   @default(0)
  lateMinutes       Int                   @default(0)
  leaveDeducted     Float                 @default(0)
  lwpDeducted       Float                 @default(0)
  calculationReason String?
  locked            Boolean               @default(false)
  lockedAt          DateTime?
  policyVersion     String?

  // ── Evaluation layer (AE-1) ─────────────────────────────────────────────
  // Provenance ids are stored WITHOUT foreign keys on purpose. This is a
  // historical explanation of a past decision, and it must survive the later
  // deletion or supersession of any policy, calendar or leave row it names --
  // exactly like an audit record.
  evaluationState         DailyAttendanceEvaluationState @default(CALCULATED)
  evaluatorVersion        Int                            @default(1)
  resolverVersion         Int?
  evaluatedAt             DateTime?
  exceptionFlags          String[]                       @default([])
  /// Digest of the source facts this result was computed from. Lets a repeat
  /// evaluation recognise "nothing changed" without rewriting the row.
  sourceFingerprint       String?
  employeeProfileId       String?
  attendancePolicyId      String?
  attendancePolicyVersion Int?
  shiftPolicyId           String?
  shiftPolicyVersion      Int?
  holidayCalendarId       String?
  weeklyOffPolicyId       String?
  holidayId               String?
  businessDayOverrideId   String?
  leaveRequestId          String?
  punchInEvidenceId       String?
  punchOutEvidenceId      String?
  workSessionIds          String[]                       @default([])
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([evaluationState])
  @@map("daily_attendance")
}

