generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  avatar       String?
  photoUrl     String?
  bio          String?
  isActive             Boolean  @default(true)
  mustChangePassword   Boolean  @default(true)
  roleId       String
  departmentId String?
  isHR              Boolean  @default(false)
  currentStatus     String   @default("OFFLINE")
  lastActiveAt      DateTime?
  workdayPolicyOverride UserWorkdayPolicyOverride?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Personal Details
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  bloodGroup         String?
  currentAddress     String?
  permanentAddress   String?
  emergencyName      String?
  emergencyPhone     String?
  emergencyRelation  String?
  userLocation       String?   @default("Pune HQ")

  // Employment Details
  employeeId         String?   @unique
  designation        String?
  employmentType     String?   @default("Full-time")
  workMode           String?   @default("Office")
  joiningDate        DateTime?
  probationPeriod    String?
  reportingManager   String?
  teamLeadName       String?
  workLocation       String?   @default("Pune HQ")
  shiftTiming        String?   @default("9:30 AM - 6:30 PM")

  // Payroll & Statutory (sensitive)
  ctcAnnual          String?
  basicSalary        String?
  salaryStructure    String?
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  accountHolderName  String?
  paymentMode        String?
  panNumber          String?
  aadhaarNumber      String?
  uanNumber          String?
  pfApplicable       Boolean?  @default(true)
  esicApplicable     Boolean?  @default(false)
  professionalTax    Boolean?  @default(true)
  taxRegime          String?

  // Verification
  verificationStatus String?   @default("Pending")
  verifiedBy         String?
  verificationDate   DateTime?
  hrNotes            String?

  role            Role              @relation(fields: [roleId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  assignedTickets    Ticket[]          @relation("TicketAssignee")
  createdTickets     Ticket[]          @relation("TicketCreator")
  comments           Comment[]
  projectMembers     ProjectMember[]
  leaveRequests      LeaveRequest[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  ticketHistory      TicketHistory[]
  ticketAssignments  TicketAssignee[]
  workSessions      WorkSession[]
  breakLogs         BreakLog[]
  attendanceEvents  AttendanceEvent[]
  managedDepts      ManagerDeptAccess[] @relation("ManagerAccess")
  employeeDocuments  EmployeeDocument[]
  operationalEvents OperationalEvent[] @relation("EventActor")
  ticketTimeLogs    TicketTimeLog[]
  assigneeCycles    ReviewCycleLog[] @relation("CycleAssignee")
  reviewerCycles    ReviewCycleLog[] @relation("CycleReviewer")

  changeRequestsTarget  EmployeeProfileChangeRequest[] @relation("ChangeRequestTarget")
  changeRequestsCreated EmployeeProfileChangeRequest[] @relation("ChangeRequestRequester")
  changeRequestsApproving EmployeeProfileChangeRequest[] @relation("ChangeRequestCurrentApprover")

  @@index([departmentId])
  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model EmployeeDocument {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType       String
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  verificationStatus String   @default("Pending")
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  uploadedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([documentType])
  @@map("employee_documents")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int
  description String?
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  users         User[]
  projects      Project[]
  tickets       Ticket[]
  taskTypes     TaskType[]
  managerAccess ManagerDeptAccess[]

  @@map("departments")
}

model Project {
  id           String        @id @default(cuid())
  projectId    String        @unique
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  priority     Priority      @default(MEDIUM)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department Department?      @relation(fields: [departmentId], references: [id])
  members    ProjectMember[]
  tickets    Ticket[]
  stages     ProjectStage[]

  @@index([departmentId])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model ProjectStage {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  order       Int       @default(0)
  /// PLANNED | ACTIVE | COMPLETED | SKIPPED  (validated at service layer)
  status      String    @default("PLANNED")
  color       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets Ticket[] @relation("TicketStage")

  @@index([projectId])
  @@index([projectId, order])
  @@map("project_stages")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Ticket {
  id            String         @id @default(cuid())
  ticketId      String         @unique
  title         String
  description   String?
  category      TicketCategory
  type          TicketType     @default(TASK)
  status        TicketStatus   @default(OPEN)
  priority      Priority       @default(MEDIUM)
  estimatedTime     Float?
  actualTime        Float?
  estimatedMinutes  Int?
  scheduledStartAt  DateTime?
  scheduledEndAt    DateTime?
  actualStartAt     DateTime?
  actualCompletedAt DateTime?
  projectId     String?
  departmentId  String?
  assignedToId  String?
  createdById   String
  dueDate           DateTime?
  scheduledFor      DateTime?
  scheduledNote     String?
  scheduleRecurring String?
  scheduleEndDate   DateTime?
  resolvedAt        DateTime?
  executionDueAt    DateTime?
  submittedAt       DateTime?
  reviewStartedAt   DateTime?
  reviewDueAt       DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  taskTypeId         String?
  taskSubtypeId      String?
  customSubtypeText  String?

  // ── Blocked overlay (Option B) ───────────────────────────────────────────
  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
  blockedReason String?
  blockedById   String?

  // ── Project Stage assignment (FP-14B) ─────────────────────────────────────
  projectStageId String?

  project      Project?        @relation(fields: [projectId], references: [id])
  projectStage ProjectStage?   @relation("TicketStage", fields: [projectStageId], references: [id], onDelete: SetNull)
  department   Department?     @relation(fields: [departmentId], references: [id])
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy    User            @relation("TicketCreator", fields: [createdById], references: [id])
  taskType     TaskType?       @relation(fields: [taskTypeId], references: [id])
  taskSubtype  TaskSubtype?    @relation(fields: [taskSubtypeId], references: [id])
  comments     Comment[]
  attachments  Attachment[]
  history      TicketHistory[]
  assignees    TicketAssignee[]
  reworkCount  Int              @default(0)
  timeLogs     TicketTimeLog[]
  reviewCycles ReviewCycleLog[]

  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdById])
  @@index([projectId])
  @@index([projectStageId])
  @@index([createdAt])
  @@index([priority])
  @@index([dueDate])
  @@index([status, assignedToId])
  @@index([status, departmentId])
  @@index([isBlocked])
  @@index([status, isBlocked])
  @@map("tickets")
}

model TicketAssignee {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String
  assignedAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_assignees")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int?
  mimeType  String?
  isPoc     Boolean  @default(false)
  pocFor    String?
  ticketId  String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  rejectedBy  String?
  rejectedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  isHalfDay   Boolean     @default(false)
  halfDayType String?

  user User @relation(fields: [userId], references: [id])
  workSessions  WorkSession[]

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([userId, status])
  @@map("leave_requests")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType @default(INFO)
  isRead     Boolean          @default(false)
  link       String?
  entityId   String?
  entityType String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model TicketHistory {
  id          String   @id @default(cuid())
  ticketId    String
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  changedAt   DateTime @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId])
  @@index([changedAt])
  @@map("ticket_history")
}

model TaskType {
  id           String        @id @default(cuid())
  name         String
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subtypes     TaskSubtype[]
  tickets      Ticket[]
  isGlobal     Boolean       @default(false)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("task_types")
}

model TaskSubtype {
  id         String    @id @default(cuid())
  name       String
  taskTypeId String
  taskType   TaskType  @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  order      Int       @default(0)

  @@unique([name, taskTypeId])
  @@index([taskTypeId])
  @@map("task_subtypes")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  DONE
  CLOSED
}

enum TicketCategory {
  IT
  FACILITIES
  HR
  OPERATIONS
  PROJECT
  ADMIN
}

enum TicketType {
  BUG
  FEATURE
  TASK
  MAINTENANCE
  SUPPORT
  INCIDENT
  REQUEST
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

model WorkSession {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  date               DateTime         @db.Date
  loginAt            DateTime?
  startWorkAt        DateTime?
  logoutAt           DateTime?
  status             String           @default("LOGGED_IN")
  totalLoggedMinutes Int              @default(0)
  totalBreakMinutes  Int              @default(0)
  totalIdleMinutes   Int              @default(0)
  totalWorkMinutes   Int              @default(0)
  leaveId            String?
  leaveRequest       LeaveRequest?    @relation(fields: [leaveId], references: [id])
  closureReason      String?
  autoClosed         Boolean          @default(false)
  autoClosedAt       DateTime?
  breakLogs          BreakLog[]
  attendanceEvents   AttendanceEvent[]
  ticketTimeLogs     TicketTimeLog[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("work_sessions")
}

model BreakLog {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  workSessionId    String
  workSession      WorkSession @relation(fields: [workSessionId], references: [id])
  breakType        String
  estimatedMinutes Int?
  startAt          DateTime
  endAt            DateTime?
  durationMinutes  Int?
  autoDetected     Boolean     @default(false)
  note             String?
  reason           String?
  source           String?
  createdAt        DateTime    @default(now())
  ticketTimeLogs   TicketTimeLog[]

  @@index([userId])
  @@index([workSessionId])
  @@map("break_logs")
}

model UserWorkdayPolicyOverride {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id])
  timezone              String?
  startTime             String?
  endTime               String?
  entryWindowStart      String?
  entryWindowEnd        String?
  exitWindowStart       String?
  exitWindowEnd         String?
  minimumWorkdayMinutes Int?
  flexible              Boolean  @default(false)
  reason                String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("user_workday_policy_overrides")
}

model AttendanceEvent {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  workSessionId String?
  workSession   WorkSession? @relation(fields: [workSessionId], references: [id])
  eventType     String
  timestamp     DateTime     @default(now())
  source        String       @default("manual")
  metadata      Json?

  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  @@map("attendance_events")
}

model OperationalEvent {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("EventActor", fields: [actorId], references: [id])
  entityType  String
  entityId    String
  action      String
  fromState   String?
  toState     String?
  metadata    Json?
  ip          String?
  device      String?
  timestamp   DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([timestamp])

  @@map("operational_events")
}

model ManagerDeptAccess {
  id           String     @id @default(cuid())
  managerId    String
  manager      User       @relation("ManagerAccess", fields: [managerId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  accessLevel  String     @default("READ")
  createdAt    DateTime   @default(now())

  @@unique([managerId, departmentId])
  @@index([managerId])
  @@map("manager_dept_access")
}

model TicketTimeLog {
  id              String   @id @default(cuid())
  ticketId        String
  userId          String
  stage           String
  ownerType       String
  source          String
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  countsAsWork    Boolean  @default(true)
  pauseReason     String?
  workSessionId   String?
  breakLogId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  workSession WorkSession? @relation(fields: [workSessionId], references: [id])
  breakLog    BreakLog?    @relation(fields: [breakLogId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([startedAt])
  @@index([workSessionId])
  @@index([ticketId, endedAt])
  @@index([userId, endedAt])
  @@map("ticket_time_logs")
}

model ReviewCycleLog {
  id                  String    @id @default(cuid())
  ticketId            String
  cycleNo             Int
  assigneeId          String?
  reviewerId          String?
  reviewStartedAt     DateTime?
  reviewEndedAt       DateTime?
  decision            String?
  feedback            String?
  assigneeWorkSeconds Int?
  reviewerWorkSeconds Int?
  reworkStartedAt     DateTime?
  reworkEndedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee User?  @relation("CycleAssignee", fields: [assigneeId], references: [id])
  reviewer User?  @relation("CycleReviewer", fields: [reviewerId], references: [id])

  @@index([ticketId])
  @@index([cycleNo])
  @@unique([ticketId, cycleNo])
  @@map("review_cycle_logs")
}

model EmployeeProfileChangeRequest {
  id                 String    @id @default(cuid())
  targetUserId       String
  requestedById      String
  requestType        String
  status             String    @default("PENDING_TL_APPROVAL")
  changes            Json
  reason             String?
  currentApproverId  String?
  tlApproverId       String?
  managerApproverId  String?
  adminApproverId    String?
  tlDecision         String?
  managerDecision    String?
  adminDecision      String?
  rejectionReason    String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  targetUser      User  @relation("ChangeRequestTarget", fields: [targetUserId], references: [id])
  requestedBy     User  @relation("ChangeRequestRequester", fields: [requestedById], references: [id])
  currentApprover User? @relation("ChangeRequestCurrentApprover", fields: [currentApproverId], references: [id])

  @@index([targetUserId])
  @@index([requestedById])
  @@index([status])
  @@index([currentApproverId])
  @@map("employee_profile_change_requests")
}
