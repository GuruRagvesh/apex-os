// A single-date, company-wide exception to the ordinary calendar.
//
// An override changes what the company EXPECTS of a date; it never erases the
// underlying calendar facts. A SPECIAL_WORKING_DAY on a Sunday leaves that date
// still a Sunday and still a weekly off — BusinessCalendarService reports both,
// and only expectedCompanyWorkingDay flips.
//
// Overrides are withdrawn by setting revokedAt, never by deletion, so a past
// attendance result can always be re-explained with the calendar that applied
// at the time.
//
// Deliberately company-wide: no employee, department or location fields, and no
// attendance-result or payroll fields. Those belong to later layers.
// A camera capture uploaded by an employee, held server-side until a punch
// consumes it. SERVER-OWNED.
//
// Punch evidence is immutable, so the photo must exist and be validated BEFORE
// the evidence row is inserted. This table is that staging step.
//
// Bytes live in private object storage, never in Postgres and never as base64.
// Only the storage reference and a server-computed hash are kept here.
//
// Short-lived and single-use: expiresAt is a technical anti-replay window, and
// the one-to-one relation to AttendancePunchEvidence means a capture can back
// exactly one punch. The uniqueness is enforced by the database, so two
// concurrent punches cannot both claim the same photo.
model AttendancePunchPhoto {
  id               String    @id @default(cuid())
  userId           String
  /// Private storage reference, e.g. cloudinary:authenticated:image:<id>:<fmt>.
  /// Never a public URL, and never accepted from the client.
  objectKey        String
  /// SHA-256 of the bytes the server actually received.
  sha256           String
  mimeType         String
  byteSize         Int
  clientCapturedAt DateTime?
  receivedAt       DateTime  @default(now())
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  user          User                     @relation(fields: [userId], references: [id])
  punchEvidence AttendancePunchEvidence?

  @@index([userId, expiresAt])
  @@map("attendance_punch_photos")
}

// A physical place attendance may be punched from. SERVER CONFIGURATION.
//
// Coordinates, radius and the accuracy threshold are administrative settings.
// An employee's device never submits any of them -- it submits only where it
// thinks it is, and the server decides whether that is acceptable.
model AttendanceLocation {
  id                    String   @id @default(cuid())
  name                  String
  latitude              Float
  longitude             Float
  /// Acceptance radius in metres. A punch at or within this distance passes.
  radiusMeters          Int      @default(150)
  /// Worst GPS accuracy still trusted. A reading vaguer than this is treated
  /// as LOW_ACCURACY even if its coordinate happens to land inside the radius.
  minimumAccuracyMeters Int      @default(100)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  employeeProfiles EmployeeAttendanceProfile[]
  punchEvidence    AttendancePunchEvidence[]

  @@index([isActive])
  @@map("attendance_locations")
}

// Immutable, append-only record of a single punch. RAW FACT ONLY.
//
// This is evidence, not a conclusion: it never stores Present, Absent, Half
// Day, Leave, LWP or any payroll consequence. Those are decided far later, by a
// different layer, FROM this evidence.
//
// Deliberately separate from AttendanceEvent. That table is the live Workday
// engine's audit stream -- nine call sites across auth and workday write LOGIN,
// START_WORK, BREAK_START and so on. Mixing legally-significant punch evidence
// into it would make the contract ambiguous by shape, and an append-only
// database trigger would then also bind the production Workday engine's audit
// writes. This table is new, has no readers, and can carry that guarantee
// safely.
//
// Server-authoritative fields (userId, businessDate, serverOccurredAt,
// receivedAt, all policy provenance, both verification states) are derived
// backend-side and are never accepted from the client.
model AttendancePunchEvidence {
  id     String    @id @default(cuid())
  userId String
  type   PunchType

  // Company business date, derived server-side through the BL-1 TVA contract.
  businessDate DateTime @db.Date

  // Three distinct instants, never collapsed: when the server considers the
  // punch to have happened, when the client says it captured it, and when the
  // request actually arrived. A retry, a slow network or a wrong device clock
  // are all visible in the gap between them.
  serverOccurredAt DateTime
  clientCapturedAt DateTime?
  receivedAt       DateTime  @default(now())

  latitude                   Float?
  longitude                  Float?
  accuracyMeters             Float?
  locationVerification       PunchLocationVerification @default(PENDING)
  // Why the server reached that verdict. Storing only VERIFIED/OUTSIDE would
  // make a past decision unexplainable once the location config changes.
  attendanceLocationId       String?
  distanceFromLocationMeters Float?
  geofenceRadiusMeters       Int?
  accuracyThresholdMeters    Int?

  /// One-use link to the staged capture. Unique, so the database itself
  /// prevents two punches sharing one photo.
  photoAssetId      String?                @unique
  photoObjectKey    String?
  photoHash         String?
  photoVerification PunchPhotoVerification @default(PENDING)

  source         PunchSource @default(WEB)
  deviceMetadata Json?
  ipAddress      String?

  // Linked in PE-4, when punches begin driving the Workday engine.
  workSessionId String?

  // Provenance from the BL-5 daily context, captured at punch time so the
  // evidence can be re-explained under the rules that actually applied.
  employeeProfileId       String?
  shiftPolicyId           String?
  shiftPolicyVersion      Int?
  attendancePolicyId      String?
  attendancePolicyVersion Int?
  contextResolverVersion  Int?

  // Retry safety. A repeated submission with the same key returns the original
  // record rather than creating a second punch.
  idempotencyKey String

  createdAt DateTime @default(now())

  user               User                  @relation(fields: [userId], references: [id])
  workSession        WorkSession?          @relation(fields: [workSessionId], references: [id])
  attendanceLocation AttendanceLocation?   @relation(fields: [attendanceLocationId], references: [id])
  photoAsset         AttendancePunchPhoto? @relation(fields: [photoAssetId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, businessDate])
  @@index([businessDate])
  @@index([type])
  @@map("attendance_punch_evidence")
}

