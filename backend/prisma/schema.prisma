model AttendancePolicy {
  id                      String               @id @default(cuid())
  financialYear           String
  name                    String
  isActive                Boolean              @default(true)
  minimumWorkingMinutes   Int                  @default(540)
  lateExemptionEnabled    Boolean              @default(true)
  faceCaptureRequired     Boolean              @default(false)
  locationCaptureRequired Boolean              @default(false)
  geoFenceEnabled         Boolean              @default(false)
  regularizationEnabled   Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  updatedById             String?
  // Immutable identity of the logical policy SERIES. V1/V2/V3 of the same
  // policy share it; a different series (e.g. Team Leader shift vs Regular
  // Employee shift) has its own. Never derived from the mutable display name.
  policyKey               String
  // ── Versioned policy lifecycle (BL-4) ──────────────────────────────────
  // status is AUTHORITATIVE. isActive above is kept as a derived mirror so the
  // pre-existing readers and seed keep working; PolicyVersionService writes both.
  version                 Int                  @default(1)
  status                  PolicyStatus         @default(DRAFT)
  effectiveFrom           DateTime             @default(now())
  effectiveTo             DateTime?
  approvedById            String?
  approvedAt              DateTime?
  createdById             String?
  supersededById          String?
  // ── Configurable management rules (BL-4) ───────────────────────────────
  // Safe defaults: anything undecided REQUIRES REVIEW rather than silently
  // deducting leave or marking absence. Management changes these by issuing a
  // NEW policy version, which never rewrites historical attendance.
  afterPunchWindowAction  PolicyDecisionAction @default(REQUIRE_REVIEW)
  insufficientHoursAction PolicyDecisionAction @default(REQUIRE_REVIEW)
  automaticHalfDayEnabled Boolean              @default(false)
  shiftPolicies           ShiftPolicy[]

  @@unique([policyKey, version])
  @@index([financialYear])
  @@index([isActive])
  @@index([policyKey])
  @@index([status])
  @@index([effectiveFrom])
  @@map("attendance_policies")
}

