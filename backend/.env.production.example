# ============================================================
# Apex OS — Backend Production Environment Variables
# Copy this file to .env and fill in real values before deploying.
# DO NOT commit .env to version control.
# ============================================================

# ── Required ──────────────────────────────────────────────
# PostgreSQL connection string (must use SSL in production: ?sslmode=require)
DATABASE_URL="postgresql://user:password@host:5432/nexus_db?schema=public&sslmode=require"

# JWT signing secret — minimum 32 characters, randomly generated
# Generate: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"

# ── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Frontend base URL (used for CORS and email links)
# No trailing slash. Must match your actual production frontend domain.
FRONTEND_URL=https://your-frontend-domain.com

# JWT expiry (default: 24h)
JWT_EXPIRES_IN=24h

# ── Optional: Email / SMTP ────────────────────────────────
# If not set, email notifications are silently skipped (app still works).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password   # Gmail: App Password (not account password)
SMTP_FROM=noreply@yourdomain.com

# ── Optional: OpenAI ─────────────────────────────────────
# If not set, AI features return "coming soon" responses gracefully.
OPENAI_API_KEY=sk-...

# ── Optional: Web Push notifications ─────────────────────
# Generate one VAPID key pair outside the repository and configure the same
# values on every backend instance. Never expose the private key to Vercel.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Optional: Cloudinary (file uploads) ──────────────────
# If not set, attachments are stored as base64 in the DB (works but not recommended for production).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Admin only: permanent-deletion storage ────────────────
# Backend / admin worker ONLY. Never in Vercel, the frontend, GitHub or chat.
# Leave blank here; set real values only in the backend's own environment.
#
# Full database backups (npm run backup:database) go to a private R2 bucket.
# Production must use exactly apex-os-production-backups.
EXPECTED_PRODUCTION_DB_HOST=
EXPECTED_PRODUCTION_DB_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apex-os-production-backups
#
# Encrypted per-user archives go to a private Google Drive, NOT to R2.
# OAuth offline access, scope drive.file. Use credentials that differ from staging.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=            # from: npm run admin:drive:authorize -- --token-out=<file>
GOOGLE_DRIVE_ARCHIVE_ROOT_FOLDER_ID=   # from: npm run admin:drive:verify -- --init-root
GOOGLE_DRIVE_ARCHIVE_ACCOUNT=ai.technoedge@gmail.com   # must equal the signed-in Google account
GOOGLE_DRIVE_ARCHIVE_ENVIRONMENT=production
