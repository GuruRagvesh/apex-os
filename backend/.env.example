# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="24h"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
# APP_ENV: controls environment-specific behavior and CORS.
# Allowed values: "development" | "staging" | "production"
# Staging: use a separate DATABASE_URL pointing to a staging/preproduction DB.
# Production: must use a dedicated long random JWT_SECRET, real SMTP, real DB.
APP_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ── Staging overrides (copy to .env.staging and fill values) ─────────────────
# DATABASE_URL="postgresql://USER:PASSWORD@STAGING_HOST:5432/nexus_staging"
# APP_ENV="staging"
# FRONTEND_URL="https://staging.apex-os.your-domain.com"
# NODE_ENV="production"

# ── Email delivery ────────────────────────────────────────────────────────────
# Provider priority: Resend (env) → SMTP (DB settings) → honest error
#
# Option 1 — Resend (recommended for Render / cloud deployments)
# Get a free API key at https://resend.com — verify your domain first.
# RESEND_FROM_EMAIL must be from a verified domain (e.g. noreply@your-domain.com)
# or use Resend's onboarding address for initial testing.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Apex OS <noreply@your-domain.com>"
#
# Option 2 — SMTP (configured via Settings UI, not env vars)
# Leave these as documentation — EmailService reads SMTP from the DB (Settings → SMTP tab).
# Setting these env vars has NO effect on email delivery; they are reference only.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Apex OS <noreply@your-domain.com>"

# ── Cloudinary (optional -- file uploads disabled if unset) ──────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── OpenAI (optional -- AI features show "coming soon" if unset) ─────────────
OPENAI_API_KEY="sk-..."

# ── Backup Vault (required for user archival) ─────────────────────────────────
# Google Drive OAuth2 credentials for permanent backup storage before archiving
# a user. Archive is BLOCKED until all four values are set.
#
# Setup:
#   1. console.cloud.google.com → Enable "Google Drive API"
#   2. Create OAuth2 credentials (Desktop app) → CLIENT_ID and CLIENT_SECRET
#   3. Run the OAuth2 consent flow → obtain REFRESH_TOKEN with Drive scope
#   4. Create a shared Google Drive folder → copy its ID from the URL
GOOGLE_DRIVE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_DRIVE_REFRESH_TOKEN="1//..."
BACKUP_VAULT_GDRIVE_FOLDER_ID="1ABCDEFGHIJKLMNOPabcdef..."
