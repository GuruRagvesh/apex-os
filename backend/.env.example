# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="24h"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
# APP_ENV: controls environment-specific behavior and CORS.
# Allowed values: "development" | "staging" | "production"
# Staging: use a separate DATABASE_URL pointing to a staging/preproduction DB.
# Production: must use a dedicated long random JWT_SECRET, real SMTP, real DB.
APP_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ── Staging overrides (copy to .env.staging and fill values) ─────────────────
# DATABASE_URL="postgresql://USER:PASSWORD@STAGING_HOST:5432/nexus_staging"
# APP_ENV="staging"
# FRONTEND_URL="https://staging.apex-os.your-domain.com"
# NODE_ENV="production"

# ── Email delivery ────────────────────────────────────────────────────────────
# Provider priority: Resend (env) → SMTP (DB settings) → honest error
#
# Option 1 — Resend (recommended for Render / cloud deployments)
# Get a free API key at https://resend.com — verify your domain first.
# RESEND_FROM_EMAIL must be from a verified domain (e.g. noreply@your-domain.com)
# or use Resend's onboarding address for initial testing.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Apex OS <noreply@your-domain.com>"
#
# Option 2 — SMTP (configured via Settings UI, not env vars)
# Leave these as documentation — EmailService reads SMTP from the DB (Settings → SMTP tab).
# Setting these env vars has NO effect on email delivery; they are reference only.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Apex OS <noreply@your-domain.com>"

# ── Cloudinary (optional -- file uploads disabled if unset) ──────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── OpenAI (optional -- AI features show "coming soon" if unset) ─────────────
OPENAI_API_KEY="sk-..."

# ── Web Push (optional -- background system notifications disabled if unset) ─
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@your-domain.com"

# ── Backup Vault — OneDrive / Microsoft Graph (required for user archival) ─────
# Microsoft Graph client-credentials upload to a shared OneDrive account.
# Archive is BLOCKED until all five values are set.
#
# Setup:
#   1. portal.azure.com → Azure Active Directory → App registrations → New registration
#   2. API permissions → Add → Microsoft Graph → Application → Files.ReadWrite.All → Grant admin consent
#   3. Certificates & secrets → New client secret → copy value into MICROSOFT_CLIENT_SECRET
#   4. Overview → copy Application (client) ID → MICROSOFT_CLIENT_ID
#   5. Overview → copy Directory (tenant) ID → MICROSOFT_TENANT_ID
#   6. Set ONEDRIVE_USER_ID to the UPN or object ID of the backup OneDrive account
#   7. Set ONEDRIVE_BACKUP_FOLDER_PATH to the folder path within that OneDrive
BACKUP_VAULT_PROVIDER="onedrive"
MICROSOFT_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MICROSOFT_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MICROSOFT_CLIENT_SECRET="your-client-secret-value"
ONEDRIVE_USER_ID="superadmin@technoedgels.com"
ONEDRIVE_BACKUP_FOLDER_PATH="/Apex OS Backup Vault/User Archives"

# ── Admin only: permanent-deletion storage (staging) ──────
# Backend web service and admin tools ONLY. Never in Vercel, the frontend, GitHub or chat.
# Leave blank here; set real values only in the staging backend's environment.
#
# Full database backups go to a private, staging-only R2 bucket. It must not be
# the production bucket, and R2_BUCKET must equal EXPECTED_STAGING_VAULT_BUCKET.
# APP_ENV="staging"
EXPECTED_STAGING_DB_HOST=
EXPECTED_STAGING_DB_NAME=
EXPECTED_STAGING_VAULT_BUCKET=         # e.g. apex-os-staging-backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
#
# Per-user archives ("Archive user") go to a private Google Drive, NOT to R2.
# The app server needs these too. OAuth offline access, scope drive.file.
# Production may reuse the same Google keys; only the ENVIRONMENT value differs.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=            # from: npm run admin:drive:authorize -- --token-out=<file>
GOOGLE_DRIVE_ARCHIVE_ROOT_FOLDER_ID=   # from: npm run admin:drive:verify -- --init-root
GOOGLE_DRIVE_ARCHIVE_ACCOUNT=ai.technoedge@gmail.com   # must equal the signed-in Google account
GOOGLE_DRIVE_ARCHIVE_ENVIRONMENT=staging
