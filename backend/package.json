{
  "name": "apex-os-backend",
  "version": "1.0.0",
  "description": "Apex Internal Business Management - Backend API",
  "author": "TechnoEdge",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "npx prisma generate",
    "build": "npx prisma generate && npx tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "db:migrate:status": "npx prisma migrate status",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPatterns='test/unit'",
    "test:integration": "jest --config jest.config.js --testPathPatterns='test/integration' --runInBand",
    "test:smoke": "jest --config jest.config.js --testPathPatterns='test/integration/smoke'",
    "test:coverage": "jest --config jest.config.js --coverage",
    "workday:audit": "ts-node scripts/audit-workday-sessions.ts --dry-run",
    "workday:repair": "ts-node scripts/audit-workday-sessions.ts --apply",
    "backfill:d2": "ts-node scripts/backfill-d2-foundation.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "db:setup": "npx prisma migrate dev --name init && npx ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/websockets": "^10.0.0",
    "@prisma/client": "^5.13.0",
    "@sentry/node": "^10.57.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "openai": "^6.37.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^5.13.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
