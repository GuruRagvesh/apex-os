# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ─── Build Outputs ───────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ─── Runtime / Cache ─────────────────────────────────────────────────────────
.cache/
.turbo/
.vercel/
.railway/
*.tsbuildinfo
next-env.d.ts

# ─── Prisma ──────────────────────────────────────────────────────────────────
# Keep migrations — exclude dev-only migration artifacts
prisma/migrations/dev*

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Test Coverage ───────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Uploads (local dev only) ────────────────────────────────────────────────
# Leading slash anchors these to the repo root so they don't accidentally
# match src/modules/uploads/ or any other nested directory named "uploads".
/uploads/
/frontend/public/uploads/

# ─── Security: Backup / Recovery / Data-Dump Artifacts ───────────────────────
*.sql
*.sql.gz
*.dump
*.bak
*.zip
*_backup_*
apex_backup_*
snapshot_*.json
*_dry_run.json
*_recovery_*.json
backup_manifest.json
recovered_*.json

# Exception: real Prisma migrations must stay tracked despite the blanket
# *.sql rule above, or `git add` will silently skip new migration files.
!backend/prisma/migrations/**/*.sql
