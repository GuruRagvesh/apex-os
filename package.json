{
  "name": "apex-os",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "architecture:check": "node scripts/architecture/validate-boundaries.mjs",
    "architecture:test": "node scripts/architecture/validate-boundaries.test.mjs",
    "frontend:verify-api-contract": "node scripts/frontend/verify-api-response-contract.mjs",
    "frontend:verify-workday-surface": "node scripts/frontend/verify-single-workday-surface.mjs",
    "frontend:verify-attendance-surface": "node scripts/frontend/verify-attendance-day-surface.mjs",
    "frontend:verify-exception-queue": "node scripts/frontend/verify-attendance-exception-queue.mjs",
    "frontend:verify-capture-paths": "node scripts/frontend/verify-punch-capture-paths.mjs",
    "frontend:verify-register": "node scripts/frontend/verify-attendance-register.mjs",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start:prod",
    "backend:verify-deployment-layout": "node scripts/deployment/verify-backend-root-layout.mjs",
    "backend:verify-module-identity": "node scripts/deployment/verify-backend-module-identity.mjs",
    "frontend:verify-import": "node scripts/frontend/verify-attendance-import.mjs"
  }
}
