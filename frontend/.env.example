# ─────────────────────────────────────────────────────────────────────────────
# NEXUS — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# Never put secrets here — use backend/.env for sensitive values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend API ─────────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production (Railway / other host) — uncomment and set:
# NEXT_PUBLIC_API_URL=https://nexus-api.up.railway.app/api

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Must point to the backend origin (no /api path)
# Local development:
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Production — uncomment and set:
# NEXT_PUBLIC_WS_URL=https://nexus-api.up.railway.app

# ─── Environment Indicator ───────────────────────────────────────────────────
# Controls the visible STAGING banner. Omit or set to "production" for live.
# Allowed values: "development" | "staging" | "production"
NEXT_PUBLIC_APP_ENV=development

# Staging example:
# NEXT_PUBLIC_APP_ENV=staging

# ─────────────────────────────────────────────────────────────────────────────
# No other secrets are needed in the frontend.
# All auth tokens are stored in localStorage by the app itself.
# ─────────────────────────────────────────────────────────────────────────────
