# ============================================================
# Apex OS — Frontend Production Environment Variables
# Copy this file to .env.production.local and fill in real values before deploying.
# DO NOT commit .env.production.local to version control.
# ============================================================

# ── Required ──────────────────────────────────────────────
# Backend API URL — no trailing slash
# Example: https://your-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api

# Backend WebSocket URL — no path suffix
# Example: https://your-api.onrender.com
NEXT_PUBLIC_WS_URL=https://your-api-domain.com

# ── Environment Banner ────────────────────────────────────
# Controls which environment banner is shown in the UI.
# Values: "production" (no banner), "staging" (yellow banner), "development" (blue banner)
NEXT_PUBLIC_APP_ENV=production
